{
  "name": "serverstarter",
  "version": "0.0.1",
  "description": "ServerStarterを利用してMinecraftのマルチプレイサーバーを素早く起動しましょう！【Start Minecraft server only ONE click! 】",
  "productName": "ServerStarter",
  "author": "CivilTT",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "【obsolete】deploy": "gh-pages -d dist/spa",
    "mcmodel": "bun util/McModel/src/main.ts && prettier --write \"./src/mcmodel/**/*.ts\""
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.0.3",
    "quasar": "^2.35.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@quasar/app-vite": "^3.10.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "node-webpmux": "^3.2.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^30 || ^28 || ^26 || ^24 || ^22.22.0"
  }
}
